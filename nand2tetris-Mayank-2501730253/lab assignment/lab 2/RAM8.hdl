// Memory of 8 registers, each 16 bits wide.
// out holds the value stored at the memory location specified by address.
// If load == 1, then the in value is loaded into the location specified by
// address at the next clock cycle.
//
// RAM8 is exactly the 8-register file, so it simply wraps RegisterFile.
// It is the building block for every larger RAM.

CHIP RAM8 {
    IN in[16], load, address[3];
    OUT out[16];

    PARTS:
    RegisterFile(in=in, load=load, address=address, out=out);
}
