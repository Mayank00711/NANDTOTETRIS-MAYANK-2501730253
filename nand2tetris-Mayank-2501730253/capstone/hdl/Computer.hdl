// The Hack computer, including CPU, ROM and RAM.
// When reset is 0, the program stored in the computer's ROM executes.
// When reset is 1, the program's execution restarts.
// Thus, to start running the program, reset must be pushed "up" (1) and
// "down" (0). From this point onwards the user is at the mercy of the
// software. In particular, depending on the program's code, the screen may
// show some output and the user may be able to interact with the computer
// via the keyboard.

CHIP Computer {
    IN reset;

    PARTS:
    // Instruction memory: the program, indexed by the program counter
    ROM32K(address=pc, out=instruction);

    // The processor
    CPU(inM=memOut, instruction=instruction, reset=reset,
        outM=outM, writeM=writeM, addressM=addressM, pc=pc);

    // Data memory + screen + keyboard
    Memory(in=outM, load=writeM, address=addressM, out=memOut);
}
