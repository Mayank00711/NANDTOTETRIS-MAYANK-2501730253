// Memory of 8192 registers, each 16 bits wide (2 x RAM4K).
// address[0..11] picks the register inside a RAM4K,
// address[12] picks which of the two RAM4K chips is used.

CHIP RAM8K {
    IN in[16], load, address[13];
    OUT out[16];

    PARTS:
    DMux(in=load, sel=address[12], a=l0, b=l1);

    RAM4K(in=in, load=l0, address=address[0..11], out=r0);
    RAM4K(in=in, load=l1, address=address[0..11], out=r1);

    Mux16(a=r0, b=r1, sel=address[12], out=out);
}
