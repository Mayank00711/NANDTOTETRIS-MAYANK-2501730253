// The complete address space of the Hack computer, memory and memory-mapped I/O.
// Outputs the value of the register selected by address. If load == 1 the
// register selected by address is overwritten with in at the next clock tick.
//
// Address map (15-bit address):
//        0 - 16383   RAM16K    (data memory)
//    16384 - 24575   Screen    (8K memory-mapped display)
//    24576           Keyboard  (the key currently pressed)
//
// address[13..14] tells the three regions apart:
//    00, 01 -> RAM      10 -> Screen      11 -> Keyboard

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Send the load signal only to the region being addressed
    DMux4Way(in=load, sel=address[13..14], a=loadRamLow, b=loadRamHigh, c=loadScreen, d=loadKbd);
    Or(a=loadRamLow, b=loadRamHigh, out=loadRam);

    RAM16K(in=in, load=loadRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=kbdOut);

    // Read from the region being addressed
    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=kbdOut, sel=address[13..14], out=out);
}
