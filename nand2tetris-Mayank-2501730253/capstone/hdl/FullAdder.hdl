// Full adder: adds three bits (a, b and a carry-in c).
// Built from two half adders: add a + b, then add the carry-in to that sum.
// carry-out is 1 if either half adder produced a carry.

CHIP FullAdder {
    IN a, b, c;
    OUT sum, carry;

    PARTS:
    HalfAdder(a=a, b=b, sum=sumAB, carry=carryAB);
    HalfAdder(a=sumAB, b=c, sum=sum, carry=carryC);
    Or(a=carryAB, b=carryC, out=carry);
}
