// 16-bit counter (Program Counter).
// A 16-bit register with load, increment and reset control bits.
// Priority: reset > load > inc.
//
// if      (reset[t] == 1) out[t+1] = 0
// else if (load[t]  == 1) out[t+1] = in[t]
// else if (inc[t]   == 1) out[t+1] = out[t] + 1
// else                    out[t+1] = out[t]

CHIP PC {
    IN in[16], load, inc, reset;
    OUT out[16];

    PARTS:
    // Candidate next values, built in priority order (lowest first)
    Inc16(in=prev, out=prevPlusOne);
    Mux16(a=prev, b=prevPlusOne, sel=inc, out=incOrHold);
    Mux16(a=incOrHold, b=in, sel=load, out=loadOrInc);
    Mux16(a=loadOrInc, b=false, sel=reset, out=next);

    // The register only needs to be written when something is requested
    Or(a=inc, b=load, out=incOrLoad);
    Or(a=incOrLoad, b=reset, out=anyChange);

    Register(in=next, load=anyChange, out=out, out=prev);
}
