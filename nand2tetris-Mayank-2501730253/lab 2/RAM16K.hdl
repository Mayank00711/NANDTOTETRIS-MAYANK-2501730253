// Memory of 16384 registers, each 16 bits wide (2 x RAM8K).
// address[0..12] picks the register inside a RAM8K,
// address[13] picks which of the two RAM8K chips is used.
// This is the Hack computer's data memory size.

CHIP RAM16K {
    IN in[16], load, address[14];
    OUT out[16];

    PARTS:
    DMux(in=load, sel=address[13], a=l0, b=l1);

    RAM8K(in=in, load=l0, address=address[0..12], out=r0);
    RAM8K(in=in, load=l1, address=address[0..12], out=r1);

    Mux16(a=r0, b=r1, sel=address[13], out=out);
}
