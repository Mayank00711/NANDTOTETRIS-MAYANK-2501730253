// The Hack Arithmetic Logic Unit.
// Computes one of 18 functions of the 16-bit inputs x and y, selected by
// six control bits, and sets two status flags.
//
// Pipeline:
//   if (zx) x = 0        if (zy) y = 0
//   if (nx) x = !x       if (ny) y = !y
//   if (f)  out = x + y  else out = x & y
//   if (no) out = !out
//   zr = (out == 0)      ng = (out < 0)
//
// Uses the standard 16-bit helper chips Mux16, Not16, And16 and Or8Way
// (built into the nand2tetris Hardware Simulator) plus our own Add16.

CHIP ALU {
    IN  x[16], y[16],  // 16-bit inputs
        zx,            // zero the x input?
        nx,            // negate the x input?
        zy,            // zero the y input?
        ny,            // negate the y input?
        f,             // compute out = x + y (if 1) or x & y (if 0)
        no;            // negate the out output?

    OUT out[16],       // 16-bit output
        zr,            // 1 if (out == 0), 0 otherwise
        ng;            // 1 if (out < 0),  0 otherwise

    PARTS:
    // Preset x: zero it, then optionally negate it
    Mux16(a=x, b=false, sel=zx, out=x1);
    Not16(in=x1, out=notX1);
    Mux16(a=x1, b=notX1, sel=nx, out=xFinal);

    // Preset y: zero it, then optionally negate it
    Mux16(a=y, b=false, sel=zy, out=y1);
    Not16(in=y1, out=notY1);
    Mux16(a=y1, b=notY1, sel=ny, out=yFinal);

    // Select the function: x & y  or  x + y
    And16(a=xFinal, b=yFinal, out=andXY);
    Add16(a=xFinal, b=yFinal, out=addXY);
    Mux16(a=andXY, b=addXY, sel=f, out=fOut);

    // Optionally negate the result, and tap off the flag bits
    Not16(in=fOut, out=notFOut);
    Mux16(a=fOut, b=notFOut, sel=no, out=out, out[15]=ng, out[0..7]=low, out[8..15]=high);

    // zr = 1 only if every one of the 16 output bits is 0
    Or8Way(in=low, out=orLow);
    Or8Way(in=high, out=orHigh);
    Or(a=orLow, b=orHigh, out=nonZero);
    Not(in=nonZero, out=zr);
}
